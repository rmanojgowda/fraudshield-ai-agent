</span></span><span>
</span><span><span>score_transaction</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>features</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span> → </span><span class="token token" style="color: rgb(0, 128, 128);">0.0141</span><span>  </span><span class="token token" style="color: rgb(110, 118, 135);"># risk score</span><span>
</span></span><span><span>decide</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>risk</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>                → </span><span class="token token" style="color: rgb(0, 128, 0);">"APPROVE"</span><span> </span><span class="token token" style="color: rgb(20, 24, 31);">/</span><span> </span><span class="token token" style="color: rgb(0, 128, 0);">"STEP_UP_AUTH"</span><span> </span><span class="token token" style="color: rgb(20, 24, 31);">/</span><span> </span><span class="token token" style="color: rgb(0, 128, 0);">"BLOCK"</span><span>
</span></span><span><span>explain</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>features</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> risk</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>     → </span><span class="token token" style="color: rgb(43, 48, 59);">[</span><span class="token token" style="color: rgb(0, 128, 0);">"Night transaction"</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> </span><span class="token token" style="color: rgb(0, 128, 0);">"High velocity"</span><span class="token token" style="color: rgb(43, 48, 59);">]</span><span>
</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(110, 118, 135);"># Decision thresholds:</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(20, 24, 31);">&lt;</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">0.25</span><span>  → APPROVE
</span></span><span><span></span><span class="token token" style="color: rgb(0, 128, 128);">0.25</span><span class="token token" style="color: rgb(20, 24, 31);">-</span><span class="token token" style="color: rgb(0, 128, 128);">0.6</span><span> → STEP_UP_AUTH
</span></span><span><span></span><span class="token token" style="color: rgb(20, 24, 31);">&gt;</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">0.6</span><span>   → BLOCK</span></span></code></pre></div></div>
<hr class="border-border-200 border-t-0.5 my-3 mx-1.5">
