oken token" style="color: rgb(179, 74, 0);">TransactionRequest</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>BaseModel</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>    Amount</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span> </span><span class="token token" style="color: rgb(179, 74, 0);">float</span><span> </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">100.0</span><span>
</span></span><span><span>    tx_count_1min</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span> </span><span class="token token" style="color: rgb(179, 74, 0);">int</span><span> </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">1</span><span>
