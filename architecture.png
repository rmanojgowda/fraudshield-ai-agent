me</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>time</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>          </span><span class="token token" style="color: rgb(110, 118, 135);"># record start</span><span>
