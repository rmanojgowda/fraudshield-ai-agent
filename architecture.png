</span><span class="token token" style="color: rgb(0, 128, 0);">        'ip': f'10.0.{i%5}.1',
</span><span class="token token" style="color: rgb(0, 128, 0);">        'V14': -7.0 if i%5==0 else 0.0,
</span><span class="token token" style="color: rgb(0, 128, 0);">        'V12': -4.0 if i%5==0 else 0.0,
</span><span class="token token" style="color: rgb(0, 128, 0);">        'country': 'RO' if i%8==0 else 'IN'
</span><span class="token token" style="color: rgb(0, 128, 0);">    }).encode()
</span><span class="token token" style="color: rgb(0, 128, 0);">    req = urllib.request.Request(
</span><span class="token token" style="color: rgb(0, 128, 0);">        'http://localhost:8000/fraud/check',
</span><span class="token token" style="color: rgb(0, 128, 0);">        data=data,
</span><span class="token token" style="color: rgb(0, 128, 0);">        headers={'Content-Type':'application/json'},
</span><span class="token token" style="color: rgb(0, 128, 0);">        method='POST'
</span><span class="token token" style="color: rgb(0, 128, 0);">    )
</span><span class="token token" style="color: rgb(0, 128, 0);">    try:
</span><span class="token token" style="color: rgb(0, 128, 0);">        r = urllib.request.urlopen(req, timeout=5)
</span><span class="token token" style="color: rgb(0, 128, 0);">        if i % 10 == 0:
</span><span class="token token" style="color: rgb(0, 128, 0);">            print(f'{i+1}/100 done')
</span><span class="token token" style="color: rgb(0, 128, 0);">    except: pass
</span><span class="token token" style="color: rgb(0, 128, 0);">    time.sleep(0.1)
</span><span class="token token" style="color: rgb(0, 128, 0);">print('Done! Check Grafana now.')
