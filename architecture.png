</span><span class="token token" style="color: rgb(0, 128, 0);">df = pd.read_csv('data/creditcard.csv')
</span><span class="token token" style="color: rgb(0, 128, 0);">fraud  = df[df['Class']==1]
</span><span class="token token" style="color: rgb(0, 128, 0);">normal = df[df['Class']==0]
