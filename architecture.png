</span></span><span><span>  </span><span class="token token" style="color: rgb(184, 10, 24);">"remaining"</span><span class="token token" style="color: rgb(20, 24, 31);">:</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">2</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span>              ← </span><span class="token token" style="color: rgb(0, 128, 128);">2</span><span> more allowed
</span></span><span><span>  </span><span class="token token" style="color: rgb(184, 10, 24);">"window_seconds"</span><span class="token token" style="color: rgb(20, 24, 31);">:</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">10</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span>        ← resets every </span><span class="token token" style="color: rgb(0, 128, 128);">10</span><span> seconds
