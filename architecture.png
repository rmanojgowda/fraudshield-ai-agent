</span><span class="token token" style="color: rgb(0, 128, 0);">    except: pass
</span><span class="token token" style="color: rgb(0, 128, 0);">    time.sleep(0.2)
</span><span class="token token" style="color: rgb(0, 128, 0);">print('Done!')
</span><span class="token token" style="color: rgb(0, 128, 0);">"</span></code></pre></div></div>
