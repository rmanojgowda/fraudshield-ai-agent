          font-base
          duration-300
          ease-[cubic-bezier(0.165,0.85,0.45,1)] h-8 w-8 rounded-md backdrop-blur-md _fill_10ocf_9 _ghost_10ocf_96" type="button" aria-label="Copy to clipboard" data-state="closed"><div class="relative"><div class="transition-all opacity-100 scale-100" style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="transition-all opacity-100 scale-100" aria-hidden="true" style="flex-shrink: 0;"><path d="M12.5 3A1.5 1.5 0 0 1 14 4.5V6h1.5A1.5 1.5 0 0 1 17 7.5v8a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 6 15.5V14H4.5A1.5 1.5 0 0 1 3 12.5v-8A1.5 1.5 0 0 1 4.5 3zm1.5 9.5a1.5 1.5 0 0 1-1.5 1.5H7v1.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5H14zM4.5 4a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5z"></path></svg></div><div class="absolute inset-0 flex items-center justify-center"><div class="transition-all opacity-0 scale-50" style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="transition-all opacity-0 scale-50" aria-hidden="true" style="flex-shrink: 0;"><path d="M15.188 5.11a.5.5 0 0 1 .752.626l-.056.084-7.5 9a.5.5 0 0 1-.738.033l-3.5-3.5-.064-.078a.501.501 0 0 1 .693-.693l.078.064 3.113 3.113 7.15-8.58z"></path></svg></div></div></div></button></div></div><div class="text-text-500 font-small p-3.5 pb-0">python</div><div class="overflow-x-auto"><pre class="code-block__code !my-0 !rounded-lg !text-sm !leading-relaxed p-3.5" style="color: rgb(20, 24, 31); background: transparent; font-family: var(--font-mono);"><code class="language-python" style="color: rgb(20, 24, 31); background: transparent; font-family: var(--font-mono); white-space: pre;"><span><span>RATE_LIMIT     </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">5</span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># max 5 requests</span><span>
</span></span><span><span>WINDOW_SECONDS </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">10</span><span>   </span><span class="token token" style="color: rgb(110, 118, 135);"># per 10 seconds</span><span>
</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(129, 0, 194);">def</span><span> </span><span class="token token" style="color: rgb(0, 81, 194);">rate_limiter_redis</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>client_ip</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span> </span><span class="token token" style="color: rgb(179, 74, 0);">str</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span> </span><span class="token token" style="color: rgb(20, 24, 31);">-</span><span class="token token" style="color: rgb(20, 24, 31);">&gt;</span><span> </span><span class="token token" style="color: rgb(179, 74, 0);">bool</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>    key  </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token string-interpolation" style="color: rgb(0, 128, 0);">f"rate:</span><span class="token token string-interpolation interpolation" style="color: rgb(43, 48, 59);">{</span><span class="token token string-interpolation interpolation">client_ip</span><span class="token token string-interpolation interpolation" style="color: rgb(43, 48, 59);">}</span><span class="token token string-interpolation" style="color: rgb(0, 128, 0);">"</span><span>  
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Redis key: "rate:127.0.0.1"</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Separate key per IP address</span><span>
</span></span><span>    
</span><span><span>    now  </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> time</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>time</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>  
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Current timestamp: 1711684175.123</span><span>
</span></span><span>    
</span><span><span>    pipe </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> redis_client</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>pipeline</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Create atomic pipeline</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># All commands execute together</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># No other request can interfere between commands</span><span>
</span></span><span>    
</span><span><span>    pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>zremrangebyscore</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>key</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">0</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> now </span><span class="token token" style="color: rgb(20, 24, 31);">-</span><span> WINDOW_SECONDS</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Remove all timestamps older than 10 seconds ago</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Example: if now=1711684175, remove timestamps &lt; 1711684165</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># This implements the "sliding window"</span><span>
</span></span><span>    
</span><span><span>    pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>zcard</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>key</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Count remaining timestamps</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># This = number of requests in last 10 seconds</span><span>
</span></span><span>    
</span><span><span>    pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>zadd</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>key</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> </span><span class="token token" style="color: rgb(43, 48, 59);">{</span><span class="token token" style="color: rgb(179, 74, 0);">str</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>now</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span> now</span><span class="token token" style="color: rgb(43, 48, 59);">}</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Add current timestamp to the set</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Key=str(timestamp), Score=timestamp</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Score is used for time-based sorting</span><span>
</span></span><span>    
</span><span><span>    pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>expire</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>key</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> WINDOW_SECONDS</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Auto-delete this key after 10 seconds</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Prevents Redis from filling up with old keys</span><span>
</span></span><span>    
</span><span><span>    results </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>execute</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># Execute all 4 commands atomically</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># results[0] = count removed (we don't use this)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># results[1] = count BEFORE adding current request</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># results[2] = result of zadd</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># results[3] = result of expire</span><span>
</span></span><span>    
</span><span><span>    count </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> results</span><span class="token token" style="color: rgb(43, 48, 59);">[</span><span class="token token" style="color: rgb(0, 128, 128);">1</span><span class="token token" style="color: rgb(43, 48, 59);">]</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># How many requests in the last 10 seconds (before this one)</span><span>
</span></span><span>    
</span><span><span>    </span><span class="token token" style="color: rgb(129, 0, 194);">return</span><span> count </span><span class="token token" style="color: rgb(20, 24, 31);">&lt;</span><span> RATE_LIMIT
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># True = allowed (under limit)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(110, 118, 135);"># False = blocked (at or over limit)</span></span></code></pre></div></div>
<hr class="border-border-200 border-t-0.5 my-3 mx-1.5">
<h3 class="text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold">Sliding Window vs Fixed Window</h3>
<p class="font-claude-response-body break-words whitespace-normal"><strong>Fixed Window (simpler but worse):</strong></p>
<div role="group" aria-label="Code" tabindex="0" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-100"><div class="sticky opacity-0 group-hover/copy:opacity-100 group-focus-within/copy:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button class="inline-flex
