</span></span><span><span>    </span><span class="token token" style="color: rgb(179, 74, 0);">$body</span><span> = </span><span class="token token" style="color: rgb(179, 74, 0);">$base</span><span> </span><span class="token token" style="color: rgb(20, 24, 31);">-replace</span><span> </span><span class="token token" style="color: rgb(0, 128, 0);">'"merchant_id"'</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> </span><span class="token token" style="color: rgb(0, 128, 0);">"`"card_id`":`"900</span><span class="token token" style="color: rgb(179, 74, 0);">$_</span><span class="token token" style="color: rgb(0, 128, 0);">`",`"merchant_id`""</span><span>
