ient</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>pipeline</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(110, 118, 135);"># Step 1: Remove old timestamps (outside 10 second window)</span><span>
</span></span><span><span>pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>zremrangebyscore</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>key</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">0</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> now </span><span class="token token" style="color: rgb(20, 24, 31);">-</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">10</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(110, 118, 135);"># Step 2: Count remaining (requests in last 10 seconds)</span><span>
</span></span><span><span>pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>zcard</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>key</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(110, 118, 135);"># Step 3: Add current timestamp</span><span>
</span></span><span><span>pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>zadd</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>key</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> </span><span class="token token" style="color: rgb(43, 48, 59);">{</span><span class="token token" style="color: rgb(179, 74, 0);">str</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>now</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span> now</span><span class="token token" style="color: rgb(43, 48, 59);">}</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(110, 118, 135);"># Step 4: Auto-expire the key</span><span>
</span></span><span><span>pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>expire</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>key</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">10</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span>
</span><span><span>results </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> pipe</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>execute</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>count </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> results</span><span class="token token" style="color: rgb(43, 48, 59);">[</span><span class="token token" style="color: rgb(0, 128, 128);">1</span><span class="token token" style="color: rgb(43, 48, 59);">]</span><span>  </span><span class="token token" style="color: rgb(110, 118, 135);"># count BEFORE adding current request</span><span>
</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(129, 0, 194);">if</span><span> count </span><span class="token token" style="color: rgb(20, 24, 31);">&gt;=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">5</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(129, 0, 194);">return</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">False</span><span>  </span><span class="token token" style="color: rgb(110, 118, 135);"># blocked</span></span></code></pre></div></div>
<p class="font-claude-response-body break-words whitespace-normal"><strong>Why pipeline?</strong> All 4 Redis commands execute atomically in one network round-trip. Without pipeline, another request could squeeze in between commands and give wrong count.</p>
<hr class="border-border-200 border-t-0.5 my-3 mx-1.5">
