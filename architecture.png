</span><span class="token token" style="color: rgb(0, 128, 0);">        'ip': '10.0.0.1',
</span><span class="token token" style="color: rgb(0, 128, 0);">        'V14': -5.0,
</span><span class="token token" style="color: rgb(0, 128, 0);">        'V12': -4.0
</span><span class="token token" style="color: rgb(0, 128, 0);">    }).encode()
</span><span class="token token" style="color: rgb(0, 128, 0);">    req = urllib.request.Request('http://localhost:8000/fraud/check', data=data, headers={'Content-Type':'application/json'}, method='POST')
