(venv) PS D:\fraud-detection&gt; $headers = @{"Content-Type"="application/json"}
&gt;&gt; $base = '{"merchant_id":"M99","ip":"192.168.1.1","Amount":1.0,"tx_count_1min":5,"tx_count_10min":20,"tx_count_60min":50,"hour":2}'
&gt;&gt; 
&gt;&gt; 1..5 | ForEach-Object {
&gt;&gt;     $body = $base -replace '"merchant_id"', "<code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">"card_id</code>":<code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">"900$_</code>",<code class="bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]">"merchant_id</code>""
&gt;&gt;     $res = Invoke-RestMethod -Uri "<a href="http://localhost:8000/fraud/check" target="_blank" class="underline">http://localhost:8000/fraud/check</a>" -Method POST -Headers $headers -Body $body
&gt;&gt;     Write-Host "Card 900$_ → Risk: $($res.risk_score) | Graph: $($res.graph_score) | Decision: $($res.decision)"
&gt;&gt;     Write-Host "  Graph signals: $($res.graph_signals -join ', ')"
&gt;&gt; }
