oken" style="color: rgb(20, 24, 31);">-</span><span>c </span><span class="token token" style="color: rgb(0, 128, 0);">"
</span></span><span class="token token" style="color: rgb(0, 128, 0);">import urllib.request, json, time
</span><span class="token token" style="color: rgb(0, 128, 0);">cards = ['card_001','card_002','card_003','card_004','card_005']
</span><span class="token token" style="color: rgb(0, 128, 0);">for i in range(50):
</span><span class="token token" style="color: rgb(0, 128, 0);">    data = json.dumps({
</span><span class="token token" style="color: rgb(0, 128, 0);">        'Amount': 100+i,
