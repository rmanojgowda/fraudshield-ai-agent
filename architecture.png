</span></span><span><span>  </span><span class="token token" style="color: rgb(184, 10, 24);">"request_id"</span><span class="token token" style="color: rgb(20, 24, 31);">:</span><span> </span><span class="token token" style="color: rgb(0, 128, 0);">"7d9631dc"</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span>
</span></span><span><span>  </span><span class="token token" style="color: rgb(184, 10, 24);">"amount"</span><span class="token token" style="color: rgb(20, 24, 31);">:</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">2500.0</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span>
</span></span><span><span>  </span><span class="token token" style="color: rgb(184, 10, 24);">"ml_score"</span><span class="token token" style="color: rgb(20, 24, 31);">:</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">0.0141</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span>
</span></span><span><span>  </span><span class="token token" style="color: rgb(184, 10, 24);">"decision"</span><span class="token token" style="color: rgb(20, 24, 31);">:</span><span> </span><span class="token token" style="color: rgb(0, 128, 0);">"APPROVE"</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span>
