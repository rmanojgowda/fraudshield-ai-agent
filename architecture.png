PS D:\fraud-detection&gt; (Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned) ; (&amp; d:\fraud-detection\venv\Scripts\Activate.ps1)
(venv) PS D:\fraud-detection&gt; cd D:\fraud-detection
(venv) PS D:\fraud-detection&gt; python -c "
&gt;&gt; import urllib.request, json, time
&gt;&gt; cards = ['card_001','card_002','card_003','card_004','card_005']
&gt;&gt; for i in range(50):
&gt;&gt;     data = json.dumps({'Amount': 100+i, 'hour': 2, 'card_id': cards[i%5], 'merchant_id': 'merchant_X', 'ip': '10.0.0.1', 'V14': -5.0, 'V12': -4.0}).encode()
&gt;&gt;     req = urllib.request.Request('<a href="http://localhost:8000/fraud/check" target="_blank" class="underline">http://localhost:8000/fraud/check</a>', data=data, headers={'Content-Type':'application/json'}, method='POST')
&gt;&gt;     try: urllib.request.urlopen(req, timeout=5)
&gt;&gt;     except: pass
&gt;&gt;     time.sleep(0.2)
&gt;&gt; print('Done!')
&gt;&gt; "</p><div class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-bg-300 to-transparent pointer-events-none"></div></div><button class="pb-3 pt-1 text-xs text-text-500/80 hover:text-text-100 transition w-3/4 text-left rounded-lg">Show more</button></div></div></div><div class="flex justify-start opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 pointer-coarse:opacity-100 transition" role="group" aria-label="Message actions"><div class="text-text-300"><div class="text-text-300 flex items-stretch justify-between"><span class="text-text-500 text-xs flex items-center mr-2">Jun 5</span><div class="flex items-center"><button type="button" data-cds="Button" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none rounded h-control font-sans text-body font-medium [&amp;:disabled:not([aria-busy])]:opacity-50 disabled:pointer-events-none transition-shadow duration-fast focus-visible:shadow-focus text-primary aria-pressed:text-accent aspect-square w-control px-0 !text-muted hover:!text-primary" aria-label="Retry"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] transition-colors duration-fast group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-aria-expanded/btn:bg-fill-ghost-hover inset-0 group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent cds-btn-squish "></span><span class="inline-flex items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: cent