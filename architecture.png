e="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>    redis_client </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> redis</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>Redis</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>host</span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span class="token token" style="color: rgb(0, 128, 0);">"localhost"</span><span class="token token" style="color: rgb(43, 48, 59);">,</span><span> port</span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span class="token token" style="color: rgb(0, 128, 128);">6379</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    redis_client</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>ping</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    REDIS_AVAILABLE </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">True</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(129, 0, 194);">print</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(0, 128, 0);">"✅ Redis connected"</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(129, 0, 194);">except</span><span> Exception</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>    REDIS_AVAILABLE </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">False</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(129, 0, 194);">print</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(0, 128, 0);">"⚠️ Redis unavailable — using in-memory fallback"</span><span class="token token" style="color: rgb(43, 48, 59);">)</span></span></code></pre></div></div>
<p class="font-claude-response-body break-words whitespace-normal"><strong>What happens during Redis failure:</strong></p>
