&gt;&gt; import pandas as pd
&gt;&gt; import numpy as np
&gt;&gt; 
&gt;&gt; df = pd.read_csv('data/creditcard.csv')
&gt;&gt; fraud  = df[df['Class']==1]
&gt;&gt; normal = df[df['Class']==0]
&gt;&gt; 
&gt;&gt; print('V-feature means: Fraud vs Normal')
&gt;&gt; print(f'Feature   Fraud      Normal    Ratio')
&gt;&gt; print('-'*45)
&gt;&gt; for col in ['V17','V14','V12','V10','V16','V3','V7','V11','V4','V18']:
&gt;&gt;     fm = fraud[col].mean()
&gt;&gt;     nm = normal[col].mean()
&gt;&gt;     ratio = abs(fm/nm) if nm != 0 else 999
&gt;&gt;     print(f'{col:&lt;8}  {fm:&gt;8.3f}   {nm:&gt;8.3f}   {ratio:&gt;6.1f}x')
&gt;&gt; "
