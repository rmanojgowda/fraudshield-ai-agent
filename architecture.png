</span><span class="token token" style="color: rgb(0, 128, 0);">for i in range(50):
</span><span class="token token" style="color: rgb(0, 128, 0);">    data = json.dumps({'Amount': 100+i, 'hour': 2, 'card_id': cards[i%5], 'merchant_id': 'merchant_X', 'ip': '10.0.0.1', 'V14': -5.0, 'V12': -4.0}).encode()
</span><span class="token token" style="color: rgb(0, 128, 0);">    req = urllib.request.Request('http://localhost:8000/fraud/check', data=data, headers={'Content-Type':'application/json'}, method='POST')
</span><span class="token token" style="color: rgb(0, 128, 0);">    try: urllib.request.urlopen(req, timeout=5)
</span><span class="token token" style="color: rgb(0, 128, 0);">    except: pass
</span><span class="token token" style="color: rgb(0, 128, 0);">    time.sleep(0.2)
</span><span class="token token" style="color: rgb(0, 128, 0);">print('Done!')
</span><span class="token token" style="color: rgb(0, 128, 0);">"</span></code></pre></div></div>
