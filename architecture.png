e="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>    redis_client</span><span class="token token" style="color: rgb(43, 48, 59);">.</span><span>ping</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    REDIS_AVAILABLE </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">True</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(129, 0, 194);">except</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>    REDIS_AVAILABLE </span><span class="token token" style="color: rgb(20, 24, 31);">=</span><span> </span><span class="token token" style="color: rgb(0, 128, 128);">False</span><span>
</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(129, 0, 194);">def</span><span> </span><span class="token token" style="color: rgb(0, 81, 194);">check_rate_limit</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>ip</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(129, 0, 194);">if</span><span> REDIS_AVAILABLE</span><span class="token token" style="color: rgb(43, 48, 59);">:</span><span>
</span></span><span><span>        </span><span class="token token" style="color: rgb(129, 0, 194);">return</span><span> rate_limiter_redis</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>ip</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(129, 0, 194);">return</span><span> rate_limiter_memory</span><span class="token token" style="color: rgb(43, 48, 59);">(</span><span>ip</span><span class="token token" style="color: rgb(43, 48, 59);">)</span><span>  </span><span class="token token" style="color: rgb(110, 118, 135);"># fallback</span></span></code></pre></div></div>
<p class="font-claude-response-body break-words whitespace-normal"><strong>Why this matters:</strong> If Redis crashes at 3am, your fraud detection system keeps running. It falls back to in-memory limiting. This is called graceful degradation — the system degrades gracefully instead of crashing completely.</p>
<hr class="border-border-200 border-t-0.5 my-3 mx-1.5">
